{"$id":"https://example.com/ai-supervisor/schemas/supervisor-order.v1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Contract for a Supervisor Order (B monitor -> A developer handoff). Illustrative draft from docs/ARCHITECTURE.md §4. The hand-written validator in src/protocol/validate-order.mjs is the authoritative enforcement; this file documents the wire contract.","properties":{"created_at":{"description":"Metadata only; never authoritative for authorship or time.","maxLength":64,"type":["string","null"]},"decision":{"enum":["ADVANCE","FIX_REQUIRED","BLOCKED","AWAIT_APPROVAL"],"type":"string"},"evidence":{"additionalProperties":false,"properties":{"checkpoint_path":{"maxLength":512,"minLength":1,"not":{"pattern":"^/"},"type":"string"},"ci":{"additionalProperties":false,"properties":{"head_sha":{"pattern":"^[0-9a-f]{40}$","type":"string"},"required_checks":{"items":{"additionalProperties":false,"properties":{"name":{"maxLength":256,"minLength":1,"type":"string"},"run_attempt":{"minimum":1,"type":["integer","null"]},"run_id":{"minimum":1,"type":["integer","null"]},"status":{"enum":["SUCCESS","FAILED","QUEUED","IN_PROGRESS","SKIPPED","CANCELLED","UNKNOWN"],"type":"string"},"url":{"maxLength":2048,"type":["string","null"]}},"required":["name","status"],"type":"object"},"maxItems":64,"minItems":1,"type":"array"}},"required":["head_sha","required_checks"],"type":"object"},"diff_ref":{"description":"Exact review source: e.g. pr diff URL, compare ref, or file blob SHA.","maxLength":512,"minLength":1,"type":"string"},"plan_path":{"description":"Repo-relative normalized path. No absolute local paths.","maxLength":512,"minLength":1,"not":{"pattern":"^/"},"type":"string"}},"required":["plan_path","checkpoint_path","diff_ref","ci"],"type":"object"},"findings":{"items":{"additionalProperties":false,"properties":{"expected":{"maxLength":4000,"minLength":1,"type":"string"},"file":{"maxLength":512,"not":{"pattern"